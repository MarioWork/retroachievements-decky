{
  "name": "retroachievements",
  "version": "0.1.0",
  "description": "Browse your RetroAchievements profile and per-game achievement progress from Steam Deck Game Mode.",
  "type": "module",
  "license": "BSD-3-Clause",
  "author": "Mario Vieira",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "typecheck:py": "pyright",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "lint:py": "ruff check .",
    "format:py": "ruff format .",
    "format:py:check": "ruff format --check .",
    "test:py": "pytest -q",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "yarn typecheck && yarn typecheck:py && yarn lint && yarn lint:py && yarn format:check && yarn format:py:check && yarn test && yarn test:py && yarn build"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@eslint/js": "^9.17.0",
    "@types/node": "^26.5.0",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "prettier": "^3.4.2",
    "pyright": "^1.1.413",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.0",
    "vitest": "^5.0.0"
  },
  "packageManager": "yarn@4.18.0"
}
